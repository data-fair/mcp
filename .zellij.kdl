// Dev environment of mcp, see @data-fair/lib-dev. Agents: npx --no df-dev status | logs <pane> | restart <pane>
layout {
  pane split_direction="vertical" {
    pane name="mcp" borderless=true
    // no containers: the MCP server calls the remote site of config/development.cjs (portalUrl)
    pane name="status" command="./node_modules/.bin/df-status"
  }
  pane split_direction="vertical" {
    pane name="api" command="bash" {
      args "-c" "FORCE_COLOR=1 NODE_ENV=development DEBUG=rate-limiting TRANSPORT=http PORT=$DEV_API_PORT OBSERVER_PORT=$DEV_OBSERVER_PORT exec ./node_modules/.bin/nodemon -e js,ts,cjs,json index.ts"
    }
    pane name="inspector" command="bash" {
      // inspector 2: SERVER_PORT is the MCP Apps sandbox; the app origin takes any free port (its default, 6278, is shared by every checkout)
      args "-c" "CLIENT_PORT=$INSPECTOR_PORT SERVER_PORT=$INSPECTOR_PROXY_PORT MCP_APP_ORIGIN_PORT=0 exec ./node_modules/.bin/mcp-inspector --transport http --server-url http://localhost:$DEV_API_PORT/mcp-server/mcp"
    }
  }
  pane name="url" size=1 borderless=true command="bash" {
    args "-c" "echo -n -e \"MCP servers at \\e[1;96mhttp://localhost:$DEV_API_PORT/mcp-server/mcp\\e[0m and /mcp-server/datasets/mcp, the inspector pane prints its URL (with its token)\"; exec sleep infinity"
  }
}
