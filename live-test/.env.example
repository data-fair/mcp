# Paste nhi-proxy's "Other tools:" line here (HTTPS_PROXY=… NODE_EXTRA_CA_CERTS=…)
HTTPS_PROXY=http://127.0.0.1:7331
NODE_EXTRA_CA_CERTS=~/.config/nhi-proxy/PROFILE/ca.crt

# the platform nhi-proxy logs into
DF_PORTAL_URL=https://staging-koumoul.com
# which server to serve: platform (the NHI's scoped tools) or datasets
DF_MCP_SERVER=platform
# image tag under test
DF_MCP_TAG=feat-openapi-mcp
